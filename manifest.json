{
  "manifest_version": 3,
  "name": "Exact Upload Date for YouTube",
  "version": "1.1.0",
  "permissions": ["storage"],
  "background": { "scripts": ["src/cache.js"] },
  "options_ui": { "page": "src/options.html" },
  "action": {
    "default_title": "YouTube video date status",
    "default_popup": "src/status.html"
  },
  "description": "Replaces YouTube's relative video dates with exact upload or publication dates.",
  "homepage_url": "https://github.com/TheRealestNwah/youtube-exact-upload-date",
  "icons": {
    "32": "icons/icon.svg",
    "48": "icons/icon.svg",
    "64": "icons/icon.svg",
    "96": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-exact-upload-date@therealestnwah.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": ["src/content.css"],
      "run_at": "document_start"
    }
  ]
}
